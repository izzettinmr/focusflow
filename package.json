{
  "name": "focusflow",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "check": "tsc -b",
    "test:ui": "node scripts/ui-test.mjs",
    "android:setup": "bash scripts/setup-android.sh",
    "android:build": "python3 scripts/build-android.py",
    "android:test": "node scripts/test-android.mjs",
    "format": "prettier --write src scripts/ui-test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
